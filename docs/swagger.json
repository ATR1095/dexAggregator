{
    "swagger": "2.0",
    "info": {
        "description": "API Gateway for the Solana DEX Aggregator.",
        "title": "DEX Aggregator API Gateway",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/",
    "paths": {
        "/v1/quote": {
            "post": {
                "description": "Find the best route and output amount for a swap",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "swap"
                ],
                "summary": "Get a token swap quote",
                "parameters": [
                    {
                        "description": "Quote Request",
                        "name": "quote",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.QuoteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sor.QuoteResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/swap": {
            "post": {
                "description": "Initiate a swap transaction via the SOR",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "swap"
                ],
                "summary": "Execute a token swap",
                "parameters": [
                    {
                        "description": "Swap Request",
                        "name": "swap",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.SwapRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sor.SwapResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.QuoteRequest": {
            "type": "object",
            "required": [
                "amount",
                "inputToken",
                "outputToken"
            ],
            "properties": {
                "amount": {
                    "type": "string"
                },
                "inputToken": {
                    "type": "string"
                },
                "outputToken": {
                    "type": "string"
                }
            }
        },
        "handlers.SwapRequest": {
            "type": "object",
            "required": [
                "amount",
                "inputToken",
                "outputToken",
                "userAddress"
            ],
            "properties": {
                "amount": {
                    "type": "string"
                },
                "inputToken": {
                    "type": "string"
                },
                "outputToken": {
                    "type": "string"
                },
                "slippageBps": {
                    "description": "0 to 10%",
                    "type": "number",
                    "maximum": 1000,
                    "minimum": 0
                },
                "userAddress": {
                    "type": "string"
                }
            }
        },
        "sor.QuoteResponse": {
            "type": "object",
            "properties": {
                "input_amount": {
                    "type": "string"
                },
                "input_token": {
                    "type": "string"
                },
                "output_amount": {
                    "type": "string"
                },
                "output_token": {
                    "type": "string"
                },
                "path": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "price_impact": {
                    "type": "number"
                }
            }
        },
        "sor.DetailedRoute": {
            "description": "A single candidate route with token path and amounts.",
            "type": "object",
            "properties": {
                "token_path": {
                    "description": "Human-readable token symbols in order (e.g. SOL -> USDC)",
                    "type": "array",
                    "items": { "type": "string" }
                },
                "pool_ids": {
                    "description": "Pool IDs used along this route",
                    "type": "array",
                    "items": { "type": "string" }
                },
                "amount_in": {
                    "description": "Atomic input amount allocated to this route",
                    "type": "string"
                },
                "amount_out": {
                    "description": "Atomic output amount from this route",
                    "type": "string"
                },
                "human_amount_in": {
                    "description": "Human-readable input amount",
                    "type": "string"
                },
                "human_amount_out": {
                    "description": "Human-readable output amount",
                    "type": "string"
                }
            }
        },
        "sor.SwapResponse": {
            "type": "object",
            "properties": {
                "tx_hash": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "route": {
                    "description": "Best route token path (backwards compatible)",
                    "type": "array",
                    "items": { "type": "string" }
                },
                "output_amount": {
                    "description": "Total atomic output amount",
                    "type": "string"
                },
                "human_output_amount": {
                    "description": "Total human-readable output amount",
                    "type": "string"
                },
                "routes": {
                    "description": "All candidate routes sorted best-first (highest output_amount first)",
                    "type": "array",
                    "items": { "$ref": "#/definitions/sor.DetailedRoute" }
                }
            }
        }
    }
}